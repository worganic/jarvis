{
  "manifest_version": 3,
  "name": "Jarvis — onglets",
  "version": "1.1.0",
  "description": "Relie Chrome à Jarvis (assistant vocal local) : liste des onglets en direct et commandes (aller sur un onglet, le fermer, en ouvrir un, lire ou cliquer dans une page, titre et participants d'une réunion Google Meet). Tout reste sur ce PC (127.0.0.1).",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Jarvis — onglets",
    "default_popup": "options.html"
  },
  "minimum_chrome_version": "116"
}
